# Supabase — copy to .env.local and fill in from Supabase Dashboard → Project Settings → API
# Use the Project URL, plus either the new sb_publishable_... key or the legacy anon/public key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Legacy variable name is also accepted:
# VITE_SUPABASE_ANON_KEY=your-anon-key

# Map style URL. OpenFreeMap is free and needs no API key.
# Alternatives: https://tiles.openfreemap.org/styles/positron | /bright | /dark
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
